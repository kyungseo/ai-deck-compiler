#!/usr/bin/env sh
# Runs lightweight repository checks before commit.

set -eu

echo "Running diff hygiene check..."
git diff --cached --check

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

BRANCH=$(git branch --show-current 2>/dev/null || echo "")
# initial commit, merge commit — branch isolation check 면제
if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
    : # skip — initial commit, no HEAD yet
elif [ -f ".git/MERGE_HEAD" ]; then
    : # skip — merge commit
elif [ "$BRANCH" = "develop" ] || [ "$BRANCH" = "main" ]; then
    PROTECTED=""
    for FILE in $STAGED_FILES; do
        case "$FILE" in
            CLAUDE.md|\
            .claude/rules/*|\
            tools/git-hooks/*)
                PROTECTED="$PROTECTED $FILE"
                ;;
        esac
    done
    if [ -n "$PROTECTED" ]; then
        if [ "$BRANCH" = "main" ]; then
            echo "ERROR: Committing protected files directly on 'main' is not allowed."
            echo "Create a feature/* or hotfix/* branch and commit there instead."
            echo "Affected files:"
            for F in $PROTECTED; do echo "  $F"; done
            exit 1
        else
            echo "WARNING: Committing protected files directly on 'develop'."
            echo "Consider using a feature/* or hotfix/* branch instead."
            echo "Affected files:"
            for F in $PROTECTED; do echo "  $F"; done
        fi
    fi
fi

for FILE in $STAGED_FILES; do
    case "$FILE" in
        tools/git-hooks/*)
            if [ -f "$FILE" ]; then
                echo "Checking shell syntax: $FILE"
                sh -n "$FILE"
            fi
            ;;
    esac
done

echo "Pre-commit checks passed."
